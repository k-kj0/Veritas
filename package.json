{
  "name": "rivet-npc-memory-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "esbuild client/main.ts --bundle --outfile=public/bundle.js --format=esm --platform=browser",
    "dev": "npm run build:client && tsx watch src/server.ts",
    "start": "npm run build:client && tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "rivetkit": "^2.3.10"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
